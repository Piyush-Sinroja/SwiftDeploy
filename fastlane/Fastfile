# =============================================================
# SwiftDeploy — Production Fastfile
# =============================================================
# All sensitive values are read from ENV variables.
# Local  → create .env from .env.template and fill values
# CI     → values injected from GitHub Secrets
#
# Branch strategy:
#   feature/* → develop  : lint + tests (PR checks)
#   develop push         : beta lane (QA TestFlight)
#   release/* push       : beta lane (regression TestFlight)
#   main push            : release lane (App Store)
# =============================================================

default_platform(:ios)

# ─── Project Constants ────────────────────────────────────────
# Change these if you rename schemes or project
PROJECT         = "SwiftDeploy.xcodeproj"
SCHEME_DEV      = "SwiftDeploy-Dev"
SCHEME_QA       = "SwiftDeploy-QA"
SCHEME_PROD     = "SwiftDeploy"
CONFIG_DEV      = "Dev Debug"
CONFIG_QA_REL   = "QA Release"
CONFIG_PROD_REL = "Prod Release"
DEVICE_TEST     = "iPhone 16"

platform :ios do

  # ─── Before All ─────────────────────────────────────────────
  # Runs before every lane.
  # setup_ci creates a temporary keychain on GitHub Actions
  # so code signing works without a GUI session.
  before_all do
    setup_ci if ENV["CI"]
  end

  # =============================================================
  # SECTION 1 — App Store Connect API Key
  # Using API key auth instead of Apple ID + password.
  # Benefits: no 2FA prompts on CI, more secure, never expires.
  # =============================================================

  # Private helper lane — creates API key object used by all
  # lanes that communicate with App Store Connect.
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id:                  ENV["ASC_KEY_ID"],
      issuer_id:               ENV["ASC_ISSUER_ID"],
      key_content:             ENV["ASC_KEY_CONTENT"],
      # Set true if ASC_KEY_CONTENT is base64 encoded
      is_key_content_base64:   false,
      in_house:                false
    )
  end

  # =============================================================
  # SECTION 2 — Linting and Testing
  # These lanes run on every PR to catch issues early.
  # =============================================================

  # Runs SwiftLint to enforce code style.
  # Fails fast on PR if any violations found.
  # Requires .swiftlint.yml in project root.
  lane :lint do
    swiftlint(
      mode:                   :lint,
      strict:                 true,
      raise_if_swiftlint_error: true,
      config_file:            ".swiftlint.yml"
    )
  end

  # Runs unit tests only.
  # Fast — no UI, no full simulator boot needed.
  # Triggered on PR to develop and main.
  lane :test_unit do
    run_tests(
      project:           PROJECT,
      scheme:            SCHEME_DEV,
      device:            DEVICE_TEST,
      code_coverage:     true,
      output_directory:  "fastlane/test_output",
      output_files:      "unit_tests.xml",
      only_testing:      ["SwiftDeployTests"]
    )
  end

  # Runs UI tests only.
  # Slower — requires full simulator boot.
  # Runs in parallel with unit tests on CI.
  lane :test_ui do
    run_tests(
      project:          PROJECT,
      scheme:           SCHEME_DEV,
      device:           DEVICE_TEST,
      output_directory: "fastlane/test_output",
      output_files:     "ui_tests.xml",
      only_testing:     ["SwiftDeployUITests"]
    )
  end

  # Runs all tests locally in sequence.
  # Use this before opening a PR to verify everything passes.
  lane :test_all do
    test_unit
    test_ui
  end

  # =============================================================
  # SECTION 3 — Code Signing (Fastlane Match)
  # Match syncs certificates and provisioning profiles
  # from the private encrypted certs repo.
  #
  # readonly: true  on CI   → only read, never create
  # readonly: false locally → create new certs if missing
  # =============================================================

  # Sync Development certificates for ALL bundle IDs.
  # All 3 bundle IDs need development certs because Dev/Stage/Prod
  # Debug schemes all run on physical devices using development signing.
  # Run: bundle exec fastlane certs_dev
  lane :certs_dev do
    api_key = asc_api_key
    match(
      type:           "development",
      app_identifier: [
        ENV["APP_IDENTIFIER_DEV"],
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:        api_key,
      readonly:       ENV["CI"] ? true : false,
      force:          false
    )
  end

  # Sync App Store certificates for ALL bundle IDs.
  # Used for: TestFlight (QA) and App Store (Prod) builds.
  # Both QA and Prod use appstore type certs for distribution.
  # Dev bundle ID included for completeness (future TestFlight dev builds).
  # Run: bundle exec fastlane certs_appstore
  lane :certs_appstore do
    api_key = asc_api_key
    match(
      type:           "appstore",
      app_identifier: [
        ENV["APP_IDENTIFIER_DEV"],
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:        api_key,
      readonly:       ENV["CI"] ? true : false,
      force:          false
    )
  end

  # Sync ALL certificates at once (development + appstore).
  # Run this when setting up project on a new machine.
  # bundle exec fastlane certs_all
  lane :certs_all do
    certs_dev
    certs_appstore
  end

  # Revoke and regenerate ALL certificates from scratch.
  # ⚠️  DANGER: Only use when certs are corrupted or expired.
  # This invalidates builds for ALL team members temporarily.
  # Requires: readonly must be false (run locally only).
  # bundle exec fastlane nuke_certs
  lane :nuke_certs do
    api_key = asc_api_key
    UI.important("⚠️  This will revoke all certificates. Continue? (y/n)")
    input = STDIN.gets.chomp
    next unless input.downcase == "y"

    match_nuke(type: "development", api_key: api_key)
    match_nuke(type: "appstore",    api_key: api_key)
    certs_all
  end

  # =============================================================
  # SECTION 4 — Device Management
  # Register new physical devices for development builds.
  # Required so QA and developers can install dev builds.
  # =============================================================

  # Register a new device in Apple Developer Portal.
  # Automatically refreshes provisioning profiles.
  # Run: bundle exec fastlane register_device
  lane :register_device do
    api_key     = asc_api_key
    device_name = prompt(text: "Device name (e.g. John iPhone 16): ")
    device_udid = prompt(text: "Device UDID: ")

    # Register in Apple Developer Portal
    register_devices(
      devices: { device_name => device_udid },
      api_key: api_key
    )

    # Refresh development provisioning profiles for ALL bundle IDs.
    # All 3 are needed because Dev/Stage/Prod Debug schemes all
    # use development signing when running on a physical device.
    match(
      type:                  "development",
      app_identifier:        [
        ENV["APP_IDENTIFIER_DEV"],
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:               api_key,
      readonly:              false,
      force_for_new_devices: true
    )

    send_slack_notification(
      message: ":iphone: New device registered: *#{device_name}*\nUDID: #{device_udid}"
    )
  end

  # Force refresh provisioning profiles for all registered devices.
  # Run when a new device was registered outside of Fastlane.
  # bundle exec fastlane sync_devices
  lane :sync_devices do
    api_key = asc_api_key
    match(
      type:                  "development",
      app_identifier:        [
        ENV["APP_IDENTIFIER_DEV"],
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:               api_key,
      readonly:              false,
      force_for_new_devices: true
    )
  end

  # =============================================================
  # SECTION 5 — Version and Build Number Management
  # =============================================================

  # Bump build number using TestFlight as source of truth.
  # Fetches latest build number from TestFlight then increments by 1.
  # This prevents conflicts regardless of where builds come from —
  # CI, manual Xcode upload, or another machine.
  # Falls back to simple increment if TestFlight fetch fails (first build).
  private_lane :bump_build_number do |options|
    api_key    = asc_api_key
    bundle_id  = options[:bundle_id] || ENV["APP_IDENTIFIER_QA"]
    version    = get_version_number(xcodeproj: PROJECT)

    # Fetch latest build number from TestFlight
    # initial_build_number: 0 means if no builds exist yet, start from 0
    latest_build = latest_testflight_build_number(
      api_key:              api_key,
      app_identifier:       bundle_id,
      version:              version,
      initial_build_number: 0
    )

    new_build = latest_build + 1

    increment_build_number(
      build_number: new_build,
      xcodeproj:    PROJECT
    )

    UI.success("Build number set to #{new_build} (was #{latest_build} on TestFlight)")
    new_build
  end

  # Bump patch version (1.0.0 → 1.0.1).
  # Use for: hotfix releases, bug fixes.
  # Commits the version bump automatically.
  lane :bump_patch do
    increment_version_number(bump_type: "patch", xcodeproj: PROJECT)
    version = get_version_number(xcodeproj: PROJECT)
    git_commit(path: ["#{PROJECT}/project.pbxproj"], message: "chore: bump version to #{version}")
    UI.success("Version bumped to #{version}")
  end

  # Bump minor version (1.0.0 → 1.1.0).
  # Use for: new feature releases.
  lane :bump_minor do
    increment_version_number(bump_type: "minor", xcodeproj: PROJECT)
    version = get_version_number(xcodeproj: PROJECT)
    git_commit(path: ["#{PROJECT}/project.pbxproj"], message: "chore: bump version to #{version}")
    UI.success("Version bumped to #{version}")
  end

  # Bump major version (1.0.0 → 2.0.0).
  # Use for: major releases, breaking changes.
  lane :bump_major do
    increment_version_number(bump_type: "major", xcodeproj: PROJECT)
    version = get_version_number(xcodeproj: PROJECT)
    git_commit(path: ["#{PROJECT}/project.pbxproj"], message: "chore: bump version to #{version}")
    UI.success("Version bumped to #{version}")
  end

  # Fetch latest build number from TestFlight.
  # Useful to check what was last uploaded before a new build.
  # bundle exec fastlane get_latest_testflight_build
  lane :get_latest_testflight_build do
    api_key = asc_api_key
    latest  = latest_testflight_build_number(
      app_identifier: ENV["APP_IDENTIFIER_QA"],
      api_key:        api_key
    )
    UI.success("Latest TestFlight build: #{latest}")
    latest
  end

  # =============================================================
  # SECTION 6 — Build Lanes
  # Private build lanes called by distribution lanes.
  # Can also be called standalone for verification.
  # =============================================================

  # Build Dev Debug IPA for physical device testing.
  # Installs directly on connected device.
  # Does NOT upload anywhere.
  # Run: bundle exec fastlane build_dev
  lane :build_dev do
    certs_dev
    build_app(
      project:          PROJECT,
      scheme:           SCHEME_DEV,
      configuration:    CONFIG_DEV,
      export_method:    "development",
      output_directory: "build",
      output_name:      "SwiftDeploy-Dev.ipa",
      export_options: {
        method: "development",
        provisioningProfiles: {
          ENV["APP_IDENTIFIER_DEV"] => "match Development #{ENV['APP_IDENTIFIER_DEV']}"
        }
      }
    )
    # Install on connected device if available
    install_on_device if !ENV["CI"]
  end

  # Build QA Release IPA.
  # Used internally by beta lane.
  # Builds with parallel targets for speed.
  private_lane :build_qa_ipa do
    build_app(
      project:          PROJECT,
      scheme:           SCHEME_QA,
      configuration:    CONFIG_QA_REL,
      output_directory: "build",
      output_name:      "SwiftDeploy-QA.ipa",
      xcargs:           "-parallelizeTargets",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          ENV["APP_IDENTIFIER_QA"] => "match AppStore #{ENV['APP_IDENTIFIER_QA']}"
        }
      }
    )
  end

  # Build Production Release IPA.
  # Used internally by release lane.
  private_lane :build_prod_ipa do
    build_app(
      project:          PROJECT,
      scheme:           SCHEME_PROD,
      configuration:    CONFIG_PROD_REL,
      output_directory: "build",
      output_name:      "SwiftDeploy.ipa",
      xcargs:           "-parallelizeTargets",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          ENV["APP_IDENTIFIER_PROD"] => "match AppStore #{ENV['APP_IDENTIFIER_PROD']}"
        }
      }
    )
  end

  # =============================================================
  # SECTION 7 — Distribution Lanes
  # These are the main lanes triggered by GitHub Actions.
  # =============================================================

  # Upload QA build to TestFlight.
  # Triggered by:
  #   - Push to develop (continuous QA)
  #   - Push to release/* (regression QA)
  # Both use the same QA app on TestFlight.
  lane :beta do
    api_key   = asc_api_key
    changelog = changelog_from_git_commits(commits_count: 10, pretty: "- %s")

    certs_appstore
    bump_build_number(bundle_id: ENV["APP_IDENTIFIER_QA"])
    build_qa_ipa

    upload_to_testflight(
      app_identifier:                    ENV["APP_IDENTIFIER_QA"],
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      changelog:                         changelog,
      # Internal testers only — not distributed to external groups
      distribute_external:               false,
      notify_external_testers:           false
    )

    version = get_version_number(xcodeproj: PROJECT)
    build   = get_build_number(xcodeproj:   PROJECT)
    branch  = git_branch

    send_slack_notification(
      message: ":rocket: *QA Build #{version} (#{build})* uploaded to TestFlight\nBranch: #{branch}\n#{changelog}"
    )
  end

  # Upload Production build to App Store Connect.
  # Triggered by: push to main.
  # Does NOT auto-submit — submit manually from App Store Connect
  # after QA approves the build.
  lane :release do
    api_key = asc_api_key

    # Safety checks — only release from main with clean state
    ensure_git_branch(branch: "main")
    ensure_git_status_clean

    changelog = changelog_from_git_commits(commits_count: 20, pretty: "- %s")

    certs_appstore
    bump_build_number(bundle_id: ENV["APP_IDENTIFIER_PROD"])
    build_prod_ipa

    upload_to_app_store(
      app_identifier:    ENV["APP_IDENTIFIER_PROD"],
      api_key:           api_key,
      skip_screenshots:  true,
      skip_metadata:     true,
      # false = upload only, submit manually when ready
      submit_for_review: false,
      force:             true
    )

    version = get_version_number(xcodeproj: PROJECT)
    build   = get_build_number(xcodeproj:   PROJECT)

    send_slack_notification(
      message: ":tada: *Production Build #{version} (#{build})* uploaded to App Store Connect\nReady for manual review submission.\n#{changelog}"
    )
  end

  # Submit the latest uploaded build for App Store review.
  # Run manually when production build is QA approved.
  # bundle exec fastlane submit_for_review
  lane :submit_for_review do
    api_key = asc_api_key
    deliver(
      app_identifier:        ENV["APP_IDENTIFIER_PROD"],
      api_key:               api_key,
      submit_for_review:     true,
      # false = manually release after approval
      automatic_release:     false,
      force:                 true,
      skip_binary_upload:    true,
      skip_screenshots:      true,
      skip_metadata:         false,
      # Answers to Apple review questions
      submission_information: {
        add_id_info_uses_idfa:                   false,
        add_id_info_serves_ads:                  false,
        add_id_info_tracks_action:               false,
        add_id_info_tracks_install:              false,
        add_id_info_limits_tracking:             false,
        export_compliance_uses_encryption:       false,
        export_compliance_is_exempt:             false,
        content_rights_has_rights:               true,
        content_rights_contains_third_party_content: false
      }
    )

    send_slack_notification(
      message: ":apple: App submitted for App Store review!"
    )
  end

  # =============================================================
  # SECTION 8 — App Store Metadata and Screenshots
  # =============================================================

  # Generate App Store screenshots automatically.
  # Requires Snapshot to be set up (fastlane snapshot init).
  # bundle exec fastlane screenshots
  lane :screenshots do
    capture_screenshots(
      scheme:        SCHEME_PROD,
      project:       PROJECT,
      clear_previous_screenshots: true
    )
    frame_screenshots(white: true)
  end

  # Upload screenshots to App Store Connect.
  # Run after generating screenshots.
  lane :upload_screenshots do
    upload_to_app_store(
      app_identifier:       ENV["APP_IDENTIFIER_PROD"],
      skip_binary_upload:   true,
      skip_metadata:        true,
      skip_screenshots:     false,
      force:                true
    )
  end

  # Upload only metadata (description, keywords, etc.)
  # without touching the binary or screenshots.
  # bundle exec fastlane upload_metadata
  lane :upload_metadata do
    upload_to_app_store(
      app_identifier:     ENV["APP_IDENTIFIER_PROD"],
      skip_binary_upload: true,
      skip_screenshots:   true,
      skip_metadata:      false,
      force:              true
    )
  end

  # =============================================================
  # SECTION 9 — Private Utility Lanes
  # =============================================================

  # Internal Slack notification helper.
  # Skips silently if SLACK_WEBHOOK_URL is not configured.
  # This way Slack is fully optional — no crash if not set up.
  private_lane :send_slack_notification do |options|
    next unless ENV["SLACK_WEBHOOK_URL"]

    slack(
      message:     options[:message],
      slack_url:   ENV["SLACK_WEBHOOK_URL"],
      success:     options.fetch(:success, true),
      payload: {
        "Branch"    => git_branch,
        "Commit"    => last_git_commit[:abbreviated_commit_hash],
        "Author"    => last_git_commit[:author]
      },
      default_payloads: []
    )
  end

  # =============================================================
  # SECTION 10 — Error Handler
  # Automatically runs if ANY lane fails.
  # Sends failure notification to Slack.
  # =============================================================

  error do |lane, exception|
    send_slack_notification(
      message: ":x: *#{lane}* failed on branch *#{git_branch}*\nError: #{exception.message}",
      success: false
    )
  end

end
