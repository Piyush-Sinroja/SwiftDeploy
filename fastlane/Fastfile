# =============================================================
# SwiftDeploy — Production Fastfile
# =============================================================
# All sensitive values read from ENV variables.
# Local  → create .env from .env.template and fill values
# CI     → values injected from GitHub Secrets
#
# Branch strategy:
#   feature/* → develop  : PR checks (lint + tests)
#   develop push         : beta lane → Stage TestFlight
#   release/* push       : beta lane → Stage TestFlight
#   tag v*.*.*-rc*       : release lane → Prod App Store Connect
#   manual dispatch      : release lane → Prod App Store Connect
#   main push            : release lane → Prod App Store Connect (hotfixes)
# =============================================================

default_platform(:ios)

# ─── Project Constants ────────────────────────────────────────
# Single source of truth for all project identifiers.
# Change here if you rename project or schemes.
APP_NAME        = "SwiftDeploy"
PROJECT         = "#{APP_NAME}.xcodeproj"
WORKSPACE       = "#{APP_NAME}.xcworkspace"
SCHEME_DEV      = "#{APP_NAME}-Dev"
SCHEME_QA       = "#{APP_NAME}-QA"
SCHEME_PROD     = "#{APP_NAME}"
CONFIG_DEV      = "Dev Debug"
CONFIG_QA_REL   = "QA Release"
CONFIG_PROD_REL = "Prod Release"
DEVICE_TEST     = "iPhone 16"
OUTPUT_DIR      = "build"

# Use workspace if it exists (CocoaPods), otherwise use project
USE_WORKSPACE   = File.exist?(WORKSPACE)

platform :ios do

  # ─── Before All ─────────────────────────────────────────────
  # setup_ci creates a temporary keychain on GitHub Actions
  # required for code signing without a GUI session
  before_all do
    setup_ci if ENV["CI"]
  end

  # =============================================================
  # SECTION 1 — App Store Connect API Key
  # API key auth — no 2FA, more secure, never expires.
  # =============================================================

  # Private helper — creates ASC API key object.
  # Called by any lane that talks to App Store Connect.
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house:              false
    )
  end

  # =============================================================
  # SECTION 2 — Environment Helpers
  # Single source of truth for scheme, bundle ID, and config
  # per environment. Change once here, works everywhere.
  # =============================================================

  # Returns scheme name for given environment.
  # environment: "dev" | "qa" | "prod"
  private_lane :get_scheme do |options|
    case options[:environment]
    when "dev"  then SCHEME_DEV
    when "qa"   then SCHEME_QA
    when "prod" then SCHEME_PROD
    else
      UI.user_error!("Unknown environment: #{options[:environment]}. Use dev, qa or prod.")
    end
  end

  # Returns bundle ID for given environment from ENV variables.
  private_lane :get_bundle_id do |options|
    case options[:environment]
    when "dev"  then ENV["APP_IDENTIFIER_DEV"]
    when "qa"   then ENV["APP_IDENTIFIER_QA"]
    when "prod" then ENV["APP_IDENTIFIER_PROD"]
    else
      UI.user_error!("Unknown environment: #{options[:environment]}. Use dev, qa or prod.")
    end
  end

  # Returns build configuration name for given environment.
  private_lane :get_config do |options|
    case options[:environment]
    when "dev"  then CONFIG_DEV
    when "qa"   then CONFIG_QA_REL
    when "prod" then CONFIG_PROD_REL
    else
      UI.user_error!("Unknown environment: #{options[:environment]}. Use dev, qa or prod.")
    end
  end

  # =============================================================
  # SECTION 3 — Linting and Testing
  # Run on every PR to catch issues before merge.
  # =============================================================

  # SwiftLint static analysis.
  # Strict mode — any violation fails the lane.
  # Requires .swiftlint.yml in project root.
  lane :lint do
    swiftlint(
      mode:                     :lint,
      strict:                   true,
      raise_if_swiftlint_error: true,
      config_file:              ".swiftlint.yml"
    )
  end

  # Unit tests only — fast, no full simulator boot.
  # Triggered on PR to develop and main.
  lane :test_unit do
    run_tests(
      project:          PROJECT,
      scheme:           SCHEME_DEV,
      device:           DEVICE_TEST,
      code_coverage:    true,
      output_directory: "fastlane/test_output",
      output_files:     "unit_tests.xml",
      only_testing:     ["SwiftDeployTests"]
    )
  end

  # UI tests only — slower, requires full simulator boot.
  # Runs parallel with unit tests on CI.
  lane :test_ui do
    run_tests(
      project:          PROJECT,
      scheme:           SCHEME_DEV,
      device:           DEVICE_TEST,
      output_directory: "fastlane/test_output",
      output_files:     "ui_tests.xml",
      only_testing:     ["SwiftDeployUITests"]
    )
  end

  # Run all tests locally before opening a PR.
  lane :test_all do
    test_unit
    test_ui
  end

  # =============================================================
  # SECTION 4 — Code Signing (Fastlane Match)
  # All certs stored encrypted in private certs repo.
  # readonly: true  → CI (never create, only read)
  # readonly: false → local (create if missing)
  # =============================================================

  # Sync Development certs for ALL bundle IDs.
  # All 3 need dev certs — Dev/Stage/Prod Debug all run on
  # physical devices using development signing.
  # Run: bundle exec fastlane certs_dev
  lane :certs_dev do
    api_key = asc_api_key
    match(
      type:           "development",
      app_identifier: [
        ENV["APP_IDENTIFIER_DEV"],
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:        api_key,
      readonly:       ENV["CI"] ? true : false,
      force:          false
    )
  end

  # Sync App Store certs for QA and Prod bundle IDs.
  # Dev bundle ID excluded — never goes to TestFlight or App Store.
  # Run: bundle exec fastlane certs_appstore
  lane :certs_appstore do
    api_key = asc_api_key
    match(
      type:           "appstore",
      app_identifier: [
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:        api_key,
      readonly:       ENV["CI"] ? true : false,
      force:          false
    )
  end

  # Sync all certificates at once.
  # Run when setting up project on a new machine.
  # bundle exec fastlane certs_all
  lane :certs_all do
    certs_dev
    certs_appstore
  end

  # Revoke and regenerate ALL certificates from scratch.
  # ⚠️  DANGER — only when certs are corrupted or expired.
  # Invalidates builds for all team members temporarily.
  # Run LOCALLY only — never on CI.
  # bundle exec fastlane nuke_certs
  lane :nuke_certs do
    api_key = asc_api_key
    UI.important("⚠️  This will revoke all certificates. Continue? (y/n)")
    input = STDIN.gets.chomp
    next unless input.downcase == "y"

    match_nuke(type: "development", api_key: api_key)
    match_nuke(type: "appstore",    api_key: api_key)
    certs_all
  end

  # =============================================================
  # SECTION 5 — Device Management
  # =============================================================

  # Register a new physical device in Apple Developer Portal.
  # Refreshes development profiles for ALL bundle IDs so the
  # new device can run Dev/Stage/Prod Debug builds.
  # Run: bundle exec fastlane register_device
  lane :register_device do
    api_key     = asc_api_key
    device_name = prompt(text: "Device name (e.g. John iPhone 16): ")
    device_udid = prompt(text: "Device UDID: ")

    register_devices(
      devices: { device_name => device_udid },
      api_key: api_key
    )

    # Force refresh all development profiles to include new UDID
    match(
      type:                  "development",
      app_identifier:        [
        ENV["APP_IDENTIFIER_DEV"],
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:               api_key,
      readonly:              false,
      force_for_new_devices: true
    )

    send_slack_notification(
      message: ":iphone: New device registered: *#{device_name}*\nUDID: #{device_udid}"
    )
  end

  # Refresh provisioning profiles when devices were registered
  # outside of Fastlane (manually on developer.apple.com).
  # bundle exec fastlane sync_devices
  lane :sync_devices do
    api_key = asc_api_key
    match(
      type:                  "development",
      app_identifier:        [
        ENV["APP_IDENTIFIER_DEV"],
        ENV["APP_IDENTIFIER_QA"],
        ENV["APP_IDENTIFIER_PROD"]
      ],
      api_key:               api_key,
      readonly:              false,
      force_for_new_devices: true
    )
  end

  # =============================================================
  # SECTION 6 — Version and Build Number Management
  # =============================================================

  # Fetch latest build number from TestFlight and increment by 1.
  # TestFlight is the source of truth — prevents conflicts if
  # builds are uploaded from multiple machines or manually.
  # initial_build_number: 0 handles the very first upload.
  private_lane :bump_build_number do |options|
    api_key   = asc_api_key
    bundle_id = options[:bundle_id] || ENV["APP_IDENTIFIER_QA"]
    version   = get_version_number(xcodeproj: PROJECT)

    latest_build = latest_testflight_build_number(
      api_key:              api_key,
      app_identifier:       bundle_id,
      version:              version,
      initial_build_number: 0
    )

    new_build = latest_build + 1
    increment_build_number(build_number: new_build, xcodeproj: PROJECT)
    UI.success("Build number: #{latest_build} → #{new_build}")
    new_build
  end

  # Bump patch version (1.0.0 → 1.0.1).
  # Use for: hotfix releases, critical bug fixes.
  # Auto-commits the change.
  lane :bump_patch do
    increment_version_number(bump_type: "patch", xcodeproj: PROJECT)
    version = get_version_number(xcodeproj: PROJECT)
    git_commit(path: ["#{PROJECT}/project.pbxproj"], message: "chore: bump version to #{version}")
    UI.success("Version bumped to #{version}")
  end

  # Bump minor version (1.0.0 → 1.1.0).
  # Use for: new feature releases.
  lane :bump_minor do
    increment_version_number(bump_type: "minor", xcodeproj: PROJECT)
    version = get_version_number(xcodeproj: PROJECT)
    git_commit(path: ["#{PROJECT}/project.pbxproj"], message: "chore: bump version to #{version}")
    UI.success("Version bumped to #{version}")
  end

  # Bump major version (1.0.0 → 2.0.0).
  # Use for: major redesigns, breaking changes.
  lane :bump_major do
    increment_version_number(bump_type: "major", xcodeproj: PROJECT)
    version = get_version_number(xcodeproj: PROJECT)
    git_commit(path: ["#{PROJECT}/project.pbxproj"], message: "chore: bump version to #{version}")
    UI.success("Version bumped to #{version}")
  end

  # Check latest TestFlight build number without incrementing.
  # Useful to verify what was last uploaded.
  # bundle exec fastlane get_latest_testflight_build
  lane :get_latest_testflight_build do
    api_key = asc_api_key
    latest  = latest_testflight_build_number(
      app_identifier: ENV["APP_IDENTIFIER_QA"],
      api_key:        api_key
    )
    UI.success("Latest TestFlight build: #{latest}")
    latest
  end

  # =============================================================
  # SECTION 7 — Build Lanes
  # =============================================================

  # Build Dev Debug IPA and install on connected device.
  # Does NOT upload anywhere — local device testing only.
  # Run: bundle exec fastlane build_dev
  lane :build_dev do
    certs_dev

    build_ipa_for_environment(environment: "dev")

    # Install on connected device if running locally
    install_on_device if !ENV["CI"]
  end

  # Core build lane used by all distribution lanes.
  # Accepts environment: "dev" | "qa" | "prod"
  # Returns hash with ipa_path and dsym_path.
  # clean: true   — prevents stale artifacts
  # include_symbols: true  — generates dSYM for crash reports
  # export_team_id — prevents wrong team signing in multi-team accounts
  private_lane :build_ipa_for_environment do |options|
    env       = options[:environment]
    scheme    = get_scheme(environment:    env)
    config    = get_config(environment:    env)
    bundle_id = get_bundle_id(environment: env)

    is_dev        = env == "dev"
    export_method = is_dev ? "development" : "app-store"
    profile_prefix = is_dev ? "match Development" : "match AppStore"

    build_params = {
      scheme:           scheme,
      configuration:    config,
      clean:            true,
      include_symbols:  true,
      export_method:    export_method,
      export_team_id:   ENV["TEAM_ID"],
      output_directory: OUTPUT_DIR,
      output_name:      "#{APP_NAME}-#{env.capitalize}.ipa",
      xcargs:           "-parallelizeTargets",
      export_options: {
        method:               export_method,
        provisioningProfiles: {
          bundle_id => "#{profile_prefix} #{bundle_id}"
        }
      }
    }

    # Use workspace if CocoaPods is present, project otherwise
    if USE_WORKSPACE
      build_params[:workspace] = WORKSPACE
    else
      build_params[:project] = PROJECT
    end

    build_app(build_params)

    # Return IPA and dSYM paths for use in upload lanes
    {
      ipa_path:  lane_context[SharedValues::IPA_OUTPUT_PATH],
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH]
    }
  end

  # =============================================================
  # SECTION 8 — Distribution Lanes
  # Main lanes triggered by GitHub Actions workflows.
  # =============================================================

  # Upload QA build to Stage TestFlight.
  # Triggered by:
  #   - push to develop (continuous QA — after each feature merge)
  #   - push to release/* (regression QA — during release preparation)
  lane :beta do
    api_key   = asc_api_key
    changelog = changelog_from_git_commits(commits_count: 10, pretty: "- %s")

    certs_appstore
    bump_build_number(bundle_id: ENV["APP_IDENTIFIER_QA"])
    result = build_ipa_for_environment(environment: "qa")

    upload_to_testflight(
      api_key:                           api_key,
      app_identifier:                    ENV["APP_IDENTIFIER_QA"],
      ipa:                               result[:ipa_path],
      # true = don't wait for Apple to finish processing
      # build appears in TestFlight after Apple processes (5-30 min)
      skip_waiting_for_build_processing: true,
      # Automatically reject previous build waiting for review
      # Prevents "build already waiting for review" errors
      reject_build_waiting_for_review:   true,
      # Contact info Apple uses if they have questions about the build
      beta_app_review_info: {
        contact_email:      ENV["BETA_CONTACT_EMAIL"],
        contact_first_name: ENV["BETA_CONTACT_FIRST_NAME"],
        contact_last_name:  ENV["BETA_CONTACT_LAST_NAME"],
        contact_phone:      ENV["BETA_CONTACT_PHONE"]
      },
      beta_app_description:     "#{APP_NAME} QA build for internal testing",
      beta_app_feedback_email:  ENV["BETA_CONTACT_EMAIL"],
      changelog:                changelog,
      # Internal testers only — no external distribution
      distribute_external:      false,
      notify_external_testers:  false
    )

    version = get_version_number(xcodeproj: PROJECT)
    build   = get_build_number(xcodeproj:   PROJECT)

    send_slack_notification(
      message: ":rocket: *QA Build #{version} (#{build})* → Stage TestFlight\nBranch: #{git_branch}\n#{changelog}"
    )
  end

  # Upload Production build to App Store Connect.
  # Does NOT submit for review — submit via submit_for_review lane
  # after QA approves the prod build.
  # Triggered by:
  #   - tag v*.*.*-rc* (after QA approves Stage regression)
  #   - manual workflow_dispatch
  #   - push to main (hotfixes)
  lane :release do
    api_key   = asc_api_key
    changelog = changelog_from_git_commits(commits_count: 20, pretty: "- %s")

    # Ensure no uncommitted local changes (safety check)
    ensure_git_status_clean

    certs_appstore
    bump_build_number(bundle_id: ENV["APP_IDENTIFIER_PROD"])
    result = build_ipa_for_environment(environment: "prod")

    upload_to_app_store(
      api_key:           api_key,
      app_identifier:    ENV["APP_IDENTIFIER_PROD"],
      ipa:               result[:ipa_path],
      skip_screenshots:  true,
      skip_metadata:     true,
      # Upload only — do NOT submit. QA must smoke test first.
      submit_for_review: false,
      force:             true
    )

    version = get_version_number(xcodeproj: PROJECT)
    build   = get_build_number(xcodeproj:   PROJECT)

    send_slack_notification(
      message: ":tada: *Prod Build #{version} (#{build})* → App Store Connect\nWaiting for QA smoke test before review submission.\n#{changelog}"
    )
  end

  # Submit existing prod build for Apple review.
  # ALWAYS run manually after QA approves the prod build.
  # Does NOT upload a new binary — submits what is already
  # sitting in App Store Connect from the release lane.
  # bundle exec fastlane submit_for_review
  lane :submit_for_review do
    api_key = asc_api_key
    deliver(
      api_key:            api_key,
      app_identifier:     ENV["APP_IDENTIFIER_PROD"],
      submit_for_review:  true,
      # false = manually release after Apple approves
      automatic_release:  false,
      force:              true,
      # true = don't upload new binary, use existing in App Store Connect
      skip_binary_upload: true,
      skip_screenshots:   true,
      skip_metadata:      false,
      # Answers to Apple compliance questions
      # Update these if your app uses encryption or third-party content
      submission_information: {
        add_id_info_uses_idfa:                       false,
        add_id_info_serves_ads:                      false,
        add_id_info_tracks_action:                   false,
        add_id_info_tracks_install:                  false,
        add_id_info_limits_tracking:                 false,
        export_compliance_uses_encryption:           false,
        export_compliance_is_exempt:                 false,
        content_rights_has_rights:                   true,
        content_rights_contains_third_party_content: false
      }
    )

    send_slack_notification(
      message: ":apple: *#{APP_NAME}* submitted for App Store review!"
    )
  end

  # =============================================================
  # SECTION 9 — App Store Metadata and Screenshots
  # =============================================================

  # Generate App Store screenshots for all device sizes.
  # Requires: fastlane snapshot init (sets up Snapfile)
  # bundle exec fastlane screenshots
  lane :screenshots do
    capture_screenshots(
      scheme:                     SCHEME_PROD,
      project:                    PROJECT,
      clear_previous_screenshots: true
    )
    frame_screenshots(white: true)
  end

  # Upload generated screenshots to App Store Connect.
  lane :upload_screenshots do
    api_key = asc_api_key
    upload_to_app_store(
      api_key:              api_key,
      app_identifier:       ENV["APP_IDENTIFIER_PROD"],
      skip_binary_upload:   true,
      skip_metadata:        true,
      skip_screenshots:     false,
      force:                true
    )
  end

  # Upload app metadata only (description, keywords, etc.)
  # without touching binary or screenshots.
  # bundle exec fastlane upload_metadata
  lane :upload_metadata do
    api_key = asc_api_key
    upload_to_app_store(
      api_key:            api_key,
      app_identifier:     ENV["APP_IDENTIFIER_PROD"],
      skip_binary_upload: true,
      skip_screenshots:   true,
      skip_metadata:      false,
      force:              true
    )
  end

  # =============================================================
  # SECTION 10 — Private Utility Lanes
  # =============================================================

  # Slack notification helper — optional.
  # Silently skips if SLACK_WEBHOOK_URL is not set.
  private_lane :send_slack_notification do |options|
    next unless ENV["SLACK_WEBHOOK_URL"]

    slack(
      message:          options[:message],
      slack_url:        ENV["SLACK_WEBHOOK_URL"],
      success:          options.fetch(:success, true),
      default_payloads: [],
      payload: {
        "Branch" => git_branch,
        "Commit" => last_git_commit[:abbreviated_commit_hash],
        "Author" => last_git_commit[:author]
      }
    )
  end

  # =============================================================
  # SECTION 11 — Error Handler
  # Runs automatically when any lane fails.
  # =============================================================

  error do |lane, exception|
    send_slack_notification(
      message: ":x: *#{lane}* failed on *#{git_branch}*\nError: #{exception.message}",
      success: false
    )
  end

end
