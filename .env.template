# =============================================================
# SwiftDeploy — Environment Variables Template
# =============================================================
# HOW TO USE:
#   1. Copy this file: cp .env.template .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to Git (it is in .gitignore)
#
# CI/CD:
#   Add each variable to GitHub Secrets with the same name.
#   GitHub Actions workflow injects them automatically.
# =============================================================

# ─── Apple Developer Account ─────────────────────────────────
# Your Apple ID email
APPLE_ID=

# Apple Developer Team ID (10 characters, letters and numbers)
# Found at: developer.apple.com → Account → Membership Details
TEAM_ID=

# App Store Connect Team ID
# Usually same as TEAM_ID. Only different for enterprise accounts.
ITC_TEAM_ID=

# ─── Bundle Identifiers ──────────────────────────────────────
# Must match exactly what you registered in Apple Developer Portal
APP_IDENTIFIER_PROD=com.yourname.swiftdeploy
APP_IDENTIFIER_QA=com.yourname.swiftdeploy.stage
APP_IDENTIFIER_DEV=com.yourname.swiftdeploy.dev

# ─── App Store Connect API Key ───────────────────────────────
# Create at: App Store Connect → Users & Access → Integrations → App Store Connect API
# Role required: App Manager
#
# Key ID: short alphanumeric string shown in the key list
ASC_KEY_ID=

# Issuer ID: UUID shown at top of the API Keys page
ASC_ISSUER_ID=

# Key Content: BASE64 encoded content of the .p8 file
# Run: base64 -i ~/Downloads/AuthKey_KEYID.p8
# Paste the single-line output here (no newlines)
ASC_KEY_CONTENT=

# Key Content: full content of the downloaded .p8 file
# Include the header and footer lines:
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
ASC_KEY_CONTENT=

# ─── Fastlane Match (Code Signing) ───────────────────────────
# URL of your private certificates repository
# Format: https://github.com/yourname/swiftdeploy-certs
MATCH_GIT_URL=

# Password used to encrypt/decrypt certificates in the certs repo
# Choose a strong password and store it safely (e.g. 1Password)
# All team members need this password to access certificates
MATCH_PASSWORD=

# Base64 encoded "username:personal_access_token" for certs repo
# Generate PAT at: github.com → Settings → Developer Settings → Personal Access Tokens
# Create token with: repo scope
# Then run: echo -n "yourusername:your_pat_token" | base64
MATCH_GIT_BASIC_AUTHORIZATION=

# ─── TestFlight Beta Review Contact ─────────────────────────
# Apple uses these details if they have questions about your beta build.
# Required for first-time TestFlight submissions to avoid rejection.
BETA_CONTACT_EMAIL=
BETA_CONTACT_FIRST_NAME=
BETA_CONTACT_LAST_NAME=
BETA_CONTACT_PHONE=

# ─── Slack Notifications (Optional) ─────────────────────────
# Incoming webhook URL for build notifications
# Create at: api.slack.com → Your Apps → Incoming Webhooks
# Leave empty to disable Slack notifications
SLACK_WEBHOOK_URL=

# ─── CI Variables (Auto-provided by GitHub Actions) ──────────
# These are set automatically by GitHub Actions.
# You do NOT need to add these to GitHub Secrets.
# Listed here for reference only.
#
# GITHUB_RUN_NUMBER → used as build number (auto-increments)
# CI                → set to "true" on GitHub Actions
